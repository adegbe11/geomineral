# Copy to .env; API reads operating-system environment variables.
DATABASE_URL=sqlite:///./.data/geomineral.db
APP_ENV=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8081,http://localhost:8081
ENABLE_LIVE_PROVIDERS=true
GEOCODER_URL=https://nominatim.openstreetmap.org/search
PROVIDER_USER_AGENT=GeoMineral/0.1 (local development)
API_ORIGIN=http://127.0.0.1:8000
# Server only. Configure a vision-capable Responses API model available to your account.
ROCK_VISION_PROVIDER=ollama
OLLAMA_VISION_MODEL=qwen3-vl:2b
# Optional paid provider; used only when ROCK_VISION_PROVIDER=openai.
OPENAI_API_KEY=
ROCK_VISION_MODEL=
