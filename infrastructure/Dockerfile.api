FROM python:3.12-slim
WORKDIR /app
COPY services/api/requirements.lock.txt /app/requirements.lock.txt
RUN pip install --no-cache-dir -r requirements.lock.txt
COPY services/api /app/services/api
COPY scripts /app/scripts
COPY infrastructure/migrations /app/infrastructure/migrations
ENV PYTHONPATH=/app/services/api
RUN useradd --uid 10001 --create-home geomineral
USER geomineral
EXPOSE 8000
CMD ["uvicorn","geomineral.main:app","--host","0.0.0.0","--port","8000","--no-access-log"]
